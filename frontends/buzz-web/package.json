{
  "name": "buzz-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && BUZZ_TAURI_STRICT=1 vite build",
    "build:hosted": "tsc --noEmit && BUZZ_TAURI_STRICT=1 VITE_RELAY_TRANSPORT=http vite build",
    "build:edge": "tsc --noEmit && BUZZ_TAURI_STRICT=1 BUZZ_EDGE_BUNDLE=1 VITE_RELAY_TRANSPORT=http vite build && node scripts/prepare-edge-bootstrap.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test-loader.mjs --test \"src/**/*.test.mjs\"",
    "test:harness": "node --import ./test-loader.mjs --test \"e2e/*.test.mjs\" \"scripts/*.test.mjs\"",
    "preview": "vite preview",
    "sync:check": "node scripts/sync-upstream.mjs --check",
    "sync:apply": "node scripts/sync-upstream.mjs --apply",
    "sync:write-manifest": "node scripts/sync-upstream.mjs --write-manifest",
    "sync:check-offline": "node scripts/sync-upstream.mjs --check-offline"
  },
